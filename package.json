{
  "name": "secure-cloud-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm build:secrets && pnpm build:audit && pnpm build:gateway && pnpm build:flags && pnpm build:identity && pnpm build:dashboard && pnpm sdk:build && pnpm build:demo-shop && pnpm build:storage",
    "build:secrets": "pnpm --filter @platform/secrets build",
    "build:audit": "pnpm --filter @platform/audit build",
    "build:gateway": "pnpm --filter @platform/gateway build",
    "build:flags": "pnpm --filter @platform/flags build",
    "build:identity": "pnpm --filter @platform/identity build",
    "build:dashboard": "pnpm --filter @platform/dashboard build",
    "sdk:build": "pnpm --filter @secure-cloud/sdk build",
    "sdk:pack": "pnpm sdk:build && cd packages/sdk && pnpm pack --pack-destination ../../.local",
    "build:demo-shop": "pnpm sdk:build && pnpm --filter @platform/demo-shop build",
    "build:storage": "cargo build --locked --release -p storage",
    "lint": "pnpm lint:ts && pnpm lint:storage && pnpm lint:secrets-rs",
    "lint:ts": "pnpm sdk:build && eslint . && prettier --check .",
    "lint:storage": "cargo fmt --all --check && cargo clippy --locked -p storage --all-targets -- -D warnings",
    "lint:secrets-rs": "cargo clippy --locked -p secrets --all-targets -- -D warnings",
    "format": "prettier --write .",
    "typecheck": "pnpm sdk:build && tsc -p scripts && tsc -p api && pnpm --filter @platform/secrets --filter @platform/audit --filter @platform/gateway --filter @platform/flags --filter @platform/identity --filter @platform/dashboard --filter @secure-cloud/sdk --filter @platform/demo-shop --filter @platform/mock-upstream --filter @platform/e2e typecheck && pnpm --filter @platform/tests exec tsc -p database",
    "test": "pnpm test:secrets && pnpm test:audit && pnpm test:gateway && pnpm test:flags && pnpm test:identity && pnpm test:dashboard && pnpm test:sdk && pnpm test:demo-shop && pnpm test:storage && pnpm test:secrets-rs",
    "test:secrets": "pnpm --filter @platform/secrets test",
    "test:audit": "pnpm --filter @platform/audit test",
    "test:gateway": "pnpm --filter @platform/gateway test",
    "test:flags": "pnpm --filter @platform/flags test",
    "test:identity": "pnpm --filter @platform/identity test",
    "test:dashboard": "pnpm --filter @platform/dashboard test",
    "test:sdk": "pnpm --filter @secure-cloud/sdk test",
    "test:demo-shop": "pnpm sdk:build && pnpm --filter @platform/demo-shop test",
    "test:storage": "cargo test --locked -p storage",
    "test:secrets-rs": "cargo test --locked -p secrets",
    "test:database": "pnpm --filter @platform/tests exec vitest run --root database",
    "test:e2e": "pnpm --filter @platform/e2e test",
    "test:compat": "pnpm test:compat:secrets && pnpm test:compat:storage && pnpm test:compat:secrets-rs",
    "test:compat:secrets": "pnpm --filter @platform/secrets exec vitest run ../../tests/secrets/compatibility.test.ts",
    "test:compat:storage": "cargo test --locked -p storage --test compatibility",
    "test:compat:secrets-rs": "cargo test --locked -p secrets --test compatibility",
    "docker:build:secrets": "docker build --file services/secrets/Dockerfile --tag secure-cloud-platform/secrets:ci .",
    "docker:build:audit": "docker build --file services/audit/Dockerfile --tag secure-cloud-platform/audit:ci .",
    "docker:build:gateway": "docker build --file services/gateway/Dockerfile --tag secure-cloud-platform/gateway:ci .",
    "docker:build:flags": "docker build --file services/flags/Dockerfile --tag secure-cloud-platform/flags:ci .",
    "docker:build:identity": "docker build --file services/identity/Dockerfile --tag secure-cloud-platform/identity:ci .",
    "docker:build:dashboard": "docker build --file apps/dashboard/Dockerfile --tag secure-cloud-platform/dashboard:ci .",
    "docker:build:demo-shop": "docker build --file apps/demo-shop/Dockerfile --tag secure-cloud-platform/demo-shop:ci .",
    "docker:build:storage": "docker build --file services/storage/Dockerfile --tag secure-cloud-platform/storage:ci .",
    "api:generate": "pnpm --filter @platform/gateway build && node scripts/openapi.ts generate",
    "api:check": "pnpm --filter @platform/gateway build && node scripts/openapi.ts check",
    "test:stack": "node scripts/check-stack.ts",
    "local:start": "docker compose up --build --detach --wait --wait-timeout 180",
    "local:stop": "docker compose down",
    "local:reset": "docker compose down --volumes --remove-orphans && node -e \"require('fs').rmSync('.local/secrets-unseal-shares.json',{force:true})\"",
    "local:logs": "docker compose logs --follow --tail 100",
    "local:seed": "node scripts/seed.ts",
    "local:add-member": "docker compose exec gateway node dist/accounts-cli.js add-member",
    "local:reset-password": "docker compose exec gateway node dist/accounts-cli.js reset-password",
    "local:secrets:init": "node scripts/local-secrets.ts init",
    "local:secrets:unseal": "node scripts/local-secrets.ts unseal",
    "local:secrets:status": "node scripts/local-secrets.ts status",
    "demo:setup": "node scripts/demo-shop-setup.ts",
    "e2e:start": "node scripts/e2e-compose.ts up --build --detach --wait --wait-timeout 180",
    "stack:up": "node scripts/e2e-compose.ts up --detach --wait --wait-timeout 180",
    "stack:down": "docker compose down --volumes",
    "docker:build": "docker compose build",
    "test:ui": "pnpm --filter @platform/dashboard test:ui",
    "test:ui:install": "pnpm --filter @platform/dashboard exec playwright install --with-deps chromium",
    "test:demo": "pnpm --filter @platform/demo-shop test:ui",
    "db:generate": "pnpm --filter @platform/gateway --filter @platform/secrets --filter @platform/audit --filter @platform/identity --filter @platform/flags db:generate",
    "db:check": "node scripts/check-migrations.ts",
    "api:breaking": "node scripts/openapi.ts breaking",
    "scan:secrets": "node scripts/security-scan.ts secrets",
    "scan:code": "node scripts/security-scan.ts code",
    "scan:deps": "node scripts/security-scan.ts deps",
    "scan:images": "node scripts/security-scan.ts images",
    "scan:rust": "cargo audit",
    "scan:rust:install": "cargo install cargo-audit --locked --version 0.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
