{
  "name": "secure-cloud-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm build:secrets && pnpm build:audit && pnpm build:gateway && pnpm build:flags && pnpm build:identity && pnpm build:dashboard && pnpm sdk:build && pnpm build:storage",
    "build:secrets": "pnpm --filter @platform/secrets build",
    "build:audit": "pnpm --filter @platform/audit build",
    "build:gateway": "pnpm --filter @platform/gateway build",
    "build:flags": "pnpm --filter @platform/flags build",
    "build:identity": "pnpm --filter @platform/identity build",
    "build:dashboard": "pnpm --filter @platform/dashboard build",
    "sdk:build": "pnpm --filter @secure-cloud/sdk build",
    "sdk:pack": "pnpm sdk:build && cd packages/sdk && pnpm pack --pack-destination ../../.local",
    "build:storage": "cargo build --locked --release -p storage",
    "lint": "pnpm lint:storage",
    "lint:storage": "cargo fmt --all --check && cargo clippy --locked -p storage --all-targets -- -D warnings",
    "typecheck": "pnpm --filter @platform/secrets --filter @platform/audit --filter @platform/gateway --filter @platform/flags --filter @platform/identity --filter @platform/dashboard --filter @secure-cloud/sdk typecheck && pnpm --filter @platform/tests exec tsc -p database",
    "test": "pnpm test:secrets && pnpm test:audit && pnpm test:gateway && pnpm test:flags && pnpm test:identity && pnpm test:dashboard && pnpm test:sdk && pnpm test:storage",
    "test:secrets": "pnpm --filter @platform/secrets test",
    "test:audit": "pnpm --filter @platform/audit test",
    "test:gateway": "pnpm --filter @platform/gateway test",
    "test:flags": "pnpm --filter @platform/flags test",
    "test:identity": "pnpm --filter @platform/identity test",
    "test:dashboard": "pnpm --filter @platform/dashboard test",
    "test:sdk": "pnpm --filter @secure-cloud/sdk test",
    "test:storage": "cargo test --locked -p storage",
    "test:database": "pnpm --filter @platform/tests exec vitest run --root database",
    "test:compat": "pnpm test:compat:secrets && pnpm test:compat:storage",
    "test:compat:secrets": "pnpm --filter @platform/secrets exec vitest run ../../tests/secrets/compatibility.test.ts",
    "test:compat:storage": "cargo test --locked -p storage --test compatibility",
    "docker:build:secrets": "docker build --file services/secrets/Dockerfile --tag secure-cloud-platform/secrets:ci .",
    "docker:build:audit": "docker build --file services/audit/Dockerfile --tag secure-cloud-platform/audit:ci .",
    "docker:build:gateway": "docker build --file services/gateway/Dockerfile --tag secure-cloud-platform/gateway:ci .",
    "docker:build:flags": "docker build --file services/flags/Dockerfile --tag secure-cloud-platform/flags:ci .",
    "docker:build:identity": "docker build --file services/identity/Dockerfile --tag secure-cloud-platform/identity:ci .",
    "docker:build:dashboard": "docker build --file apps/dashboard/Dockerfile --tag secure-cloud-platform/dashboard:ci .",
    "docker:build:storage": "docker build --file services/storage/Dockerfile --tag secure-cloud-platform/storage:ci .",
    "api:generate": "pnpm --filter @platform/gateway build && node scripts/openapi.ts generate",
    "api:check": "pnpm --filter @platform/gateway build && node scripts/openapi.ts check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3"
  }
}
