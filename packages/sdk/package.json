{
  "name": "@secure-cloud/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The secure-cloud SDK for Node.js: proxy calls, encrypted files and user pools, with optional Express helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
