# Optional overrides for the LOCAL stack. Copy to .env (git-ignored) and edit;
# `docker compose up --build` reads it automatically. Without a .env file the
# same local-only defaults in docker-compose.yml are used.
#
# These values are for your machine only. Never use them on a server: real
# environments generate their own (see deploy/docker-compose.yml). No AWS
# settings are needed to run or test anything locally.

# Port of the API gateway on 127.0.0.1 (it isn't reachable from other machines)
GATEWAY_PORT=8080

# Postgres and Redis passwords (both are only reachable inside Docker).
# POSTGRES_PASSWORD is the admin login, used only for setup and the gateway's
# migrations; each service has its own login (deploy/postgres-setup.sql).
POSTGRES_PASSWORD=local-only-postgres-password
GATEWAY_DB_PASSWORD=local-only-gateway-db-password
SECRETS_DB_PASSWORD=local-only-secrets-db-password
STORAGE_DB_PASSWORD=local-only-storage-db-password
# The audit database: migrations use their own login; the running service's
# login can only insert and read audit rows.
AUDIT_MIGRATOR_DB_PASSWORD=local-only-audit-migrator-db-password
AUDIT_DB_PASSWORD=local-only-audit-db-password
REDIS_PASSWORD=local-only-redis-password

# Temporary token for the /admin API, at least 32 characters.
# Real admin login arrives with the admin dashboard.
ADMIN_TOKEN=local-only-admin-token-do-not-use-elsewhere
# The /admin API is OFF unless this is true. Local tests only: the gateway
# refuses to start with it when NODE_ENV=production.
ADMIN_API_ENABLED=false

# --- Dashboard API (docs/decisions/0016) -----------------------------------------
# The only origin allowed to call it with cookies (the future frontend)
DASHBOARD_ORIGIN=http://localhost:3000
# Server secret for CSRF tokens, at least 32 characters
SESSION_SECRET=local-only-session-secret-do-not-use-elsewhere
# An access token (session cookie) works this long (ms); then the gateway
# renews it silently with the refresh cookie (docs/decisions/0037)
SESSION_ACCESS_TTL_MS=900000
# A refresh token (refresh cookie) works this long (ms). Each silent renewal
# gives the new one a fresh 30 days, so only 30 days unused end a session
# (docs/decisions/0037)
SESSION_REFRESH_TTL_MS=2592000000
# Sign-ups, logins and password changes per window, per IP and per email
RATE_LIMIT_AUTH_PER_IP=10
RATE_LIMIT_AUTH_PER_EMAIL=5

# Server-side secret used to hash API keys (HMAC-SHA-256), at least 32
# characters. Changing it invalidates every existing API key.
API_KEY_HASH_SECRET=local-only-api-key-hash-secret-do-not-use-elsewhere

# Start of every new API key
API_KEY_PREFIX=sk_local_

# --- Rate limits (counted in Redis) ---------------------------------------------
# Length of each window, in milliseconds
RATE_LIMIT_WINDOW_MS=60000
# Requests per window for each API key
RATE_LIMIT_REQUESTS_PER_KEY=600
# Uploads (POST /v1/storage/files) per window for each API key
RATE_LIMIT_UPLOADS_PER_KEY=60
# Failed API key attempts per window from one client IP; then 429 for that IP
RATE_LIMIT_FAILED_AUTH_PER_IP=20
# Requests to /admin per window from one client IP
RATE_LIMIT_ADMIN_PER_IP=30

# Which proxies may set X-Forwarded-For (the client's real IP). Leave "false"
# unless the gateway sits behind your own load balancer; then list only its
# addresses or ranges, e.g. 10.0.0.0/8. Never "true": anyone could fake their IP.
TRUST_PROXY=false

# --- Request limits ---------------------------------------------------------------
# Largest upload, in bytes (1 GiB); bigger gets 413
MAX_UPLOAD_BYTES=1073741824
# Largest secret value, in bytes of UTF-8 (64 KiB); bigger gets 413
MAX_SECRET_BYTES=65536

# --- Encrypted storage ----------------------------------------------------------
# Default storage limit for each tenant, in bytes (5 GiB). An upload that
# would go over it gets 413 STORAGE_QUOTA_EXCEEDED.
STORAGE_QUOTA_BYTES=5368709120
# Lets the storage service (and only it) ask the secrets service to protect
# and unprotect file keys. At least 32 characters; the gateway never has it.
INTERNAL_SERVICE_TOKEN=local-only-internal-service-token-do-not-use-elsewhere

# --- Secrets: sealed startup ----------------------------------------------------
# The secrets service has NO master key setting. It starts sealed and is
# unsealed with 3 of the 5 shares made when it was initialised (README,
# "Secrets: first-time setup"; docs/decisions/0012-sealed-startup.md).
#
# Lets `pnpm local:secrets:init` / `local:secrets:unseal` keep the shares in
# .local/ (git-ignored) so you don't have to type them. LOCAL DEVELOPMENT
# ONLY: never set this anywhere else.
LOCAL_DEV_MODE=false
# Forget submitted shares this long after the first one (ms)
UNSEAL_TIMEOUT_MS=600000
# Failed unseal attempts allowed before a lockout, and the lockout (ms)
UNSEAL_MAX_FAILED_ATTEMPTS=5
UNSEAL_LOCKOUT_MS=300000
# How long sealing waits for secrets requests in progress (ms)
SEAL_DRAIN_TIMEOUT_MS=10000

# --- Proxy route (secret injection) ----------------------------------------------
# Outside hosts that proxy connections may point at (comma-separated host
# names). Locally: the pretend outside API that runs on the internal network.
PROXY_ALLOWED_HOSTS=mock-upstream
# LOCAL MOCK ONLY: also allow http:// and private addresses (the mock is
# both). The gateway refuses to start with this when NODE_ENV=production.
# Never set it anywhere else.
PROXY_ALLOW_PRIVATE_TARGETS=true

# --- API docs ----------------------------------------------------------------------
# Serve the interactive API docs (Swagger UI) at /docs. Off by default; the
# specification itself is committed as api/openapi.v1.json.
API_DOCS_ENABLED=false

# --- Audit log (docs/decisions/0015) ---------------------------------------------
# Server key for the audit chain's HMACs, at least 32 characters. Changing it
# makes every existing chain fail verification.
AUDIT_HMAC_KEY=local-only-audit-hmac-key-do-not-use-elsewhere
# Each service's own token for sending audit events (all different, at least
# 32 characters). The audit service has all of them.
AUDIT_TOKEN_GATEWAY=local-only-audit-token-gateway-do-not-use-elsewhere
AUDIT_TOKEN_SECRETS=local-only-audit-token-secrets-do-not-use-elsewhere
AUDIT_TOKEN_STORAGE=local-only-audit-token-storage-do-not-use-elsewhere
AUDIT_TOKEN_IDENTITY=local-only-audit-token-identity-do-not-use-elsewhere
AUDIT_TOKEN_FLAGS=local-only-audit-token-flags-do-not-use-elsewhere

# --- User pools (docs/decisions/0025) -----------------------------------------------
# The identity service's database login password.
IDENTITY_DB_PASSWORD=local-only-identity-db-password
# Lets the identity service (and only it) have the secrets service wrap the
# user pools' signing data keys. At least 32 characters; not the same as
# INTERNAL_SERVICE_TOKEN.
IDENTITY_SERVICE_TOKEN=local-only-identity-service-token-do-not-use-elsewhere
# The gateway's address as apps see it: the user pools' token issuer and
# JWKS address are built from it.
PUBLIC_BASE_URL=http://localhost:8080

# --- Feature flags (docs/decisions/0026) --------------------------------------------
# The flags service's database login password.
FLAGS_DB_PASSWORD=local-only-flags-db-password
# Shown as "version" in every log line (deployments set the commit)
SERVICE_VERSION=dev

DASHBOARD_PORT=3000
# Where the dashboard's pages tell the browser to find the gateway. Use
# localhost, like the dashboard: the same site, so the session cookie is sent.
DASHBOARD_API_ORIGIN=http://localhost:8080

# The demo shop (apps/demo-shop, LOCAL ONLY): a pretend customer of the
# platform on http://localhost:3100. Its API key and admin password are NOT
# set here: LOCAL_DEV_MODE=true pnpm demo:setup writes them to
# .local/demo-shop.env (git-ignored).
DEMO_SHOP_PORT=3100
# Which platform pnpm demo:start points the demo shop at: local (this
# machine's stack: gateway 127.0.0.1:8080, dashboard localhost:3000) or live
# (the deployed server; the shop still runs only on this machine). Each target
# keeps its own API key and pool ID in .local/ (docs/demo-shop-targets.md).
DEMO_SHOP_TARGET=local
# The live API for DEMO_SHOP_TARGET=live.
DEMO_SHOP_LIVE_API_URL=https://api.securee-cloud.duckdns.org
# The pretend payment provider's key (tools/mock-upstream). A fake value;
# demo:setup stores the same one as the shop's payment-api-key secret.
MOCK_PAYMENT_API_KEY=local-demo-payment-key

# Where the end-to-end tests find the gateway
GATEWAY_URL=http://127.0.0.1:8080

# --- Automatic deployment (docs/decisions/0035, server only) -------------------------
# Set by the CI deploy job on the server, never locally: deploy.sh pulls
# $IMAGE_REPOSITORY/<service>:$IMAGE_TAG (the commit SHA) from ECR instead of building.
# IMAGE_REPOSITORY=ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/secure-cloud-platform
# IMAGE_TAG=<full commit SHA>
