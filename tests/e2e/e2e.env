# Settings for the stack the end-to-end tests run against. Small limits and a
# 2-second window let the rate limit tests run quickly without long sleeps.
# Used by `pnpm e2e:start` (locally) and `pnpm stack:up` (CI); the tests read
# this file too, so they always agree with the running stack.
# Secrets aren't set here: the local defaults (or CI's generated values) apply.
RATE_LIMIT_WINDOW_MS=2000
RATE_LIMIT_REQUESTS_PER_KEY=20
RATE_LIMIT_UPLOADS_PER_KEY=5
RATE_LIMIT_FAILED_AUTH_PER_IP=5
RATE_LIMIT_ADMIN_PER_IP=60
MAX_UPLOAD_BYTES=10485760
MAX_SECRET_BYTES=4096
# The e2e tests set up tenants with the /admin API (local tests only).
ADMIN_API_ENABLED=true
# Generous enough for the tests' own sign-ups and logins from one IP.
RATE_LIMIT_AUTH_PER_IP=40
RATE_LIMIT_AUTH_PER_EMAIL=4
# Short-lived access tokens, so every dashboard test (API and browser)
# also exercises the gateway's silent refresh (docs/decisions/0024).
SESSION_ACCESS_TTL_MS=3000
# A small storage limit so the e2e tests can reach it quickly.
STORAGE_QUOTA_BYTES=31457280
