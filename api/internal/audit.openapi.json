                "secrets.initialised",
                "secrets.unsealed",
                "secrets.sealed",
                "file.uploaded",
                "file.downloaded",
                "file.deleted",
                "file.access_denied",
                "user.signed_up",
                "user.logged_in",
                "user.login_failed",
                "user.logged_out",
                "user.password_changed",
                "membership.added",
                "membership.removed",
                "user.profile_updated",
                "user.session_revoked",
