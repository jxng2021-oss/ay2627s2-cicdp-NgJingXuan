{
  "openapi": "3.0.3",
  "info": {
    "title": "Flags service (internal)",
    "version": "1.0.0",
    "description": "The contract between the gateway and the flags service (feature flags, docs/decisions/0026). Internal network only; never in the public spec. Hand-written: change it together with both sides' contract tests."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness (the database)",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/flags": {
      "get": {
        "summary": "A tenant's flags, by key",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "description": "Tenant verified by the gateway (from the API key or the dashboard membership). The only source of the tenant.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "description": "The gateway's request ID, used in this service's logs and errors",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "description": "The verified API key's or dashboard user's ID, for the audit log only. Ignored unless a UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Type",
            "in": "header",
            "required": false,
            "description": "Whose ID X-Actor-Id is: api_key (default) or user. For the audit log only.",
            "schema": {
              "type": "string",
              "enum": ["api_key", "user"]
            }
          },
          {
            "name": "X-Client-Ip",
            "in": "header",
            "required": false,
            "description": "The client's IP address as the gateway saw it, for the audit log only.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Done",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["flags"],
                  "additionalProperties": false,
                  "properties": {
                    "flags": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Flag"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: invalid input or X-Tenant-Id, or a value of the wrong kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: not from the internal network",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: shutting down, or the audit log is down (changes are refused)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a flag, off in every environment (recorded first: feature_flag.created)",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "description": "Tenant verified by the gateway (from the API key or the dashboard membership). The only source of the tenant.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "description": "The gateway's request ID, used in this service's logs and errors",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "description": "The verified API key's or dashboard user's ID, for the audit log only. Ignored unless a UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Type",
            "in": "header",
            "required": false,
            "description": "Whose ID X-Actor-Id is: api_key (default) or user. For the audit log only.",
            "schema": {
              "type": "string",
              "enum": ["api_key", "user"]
            }
          },
          {
            "name": "X-Client-Ip",
            "in": "header",
            "required": false,
            "description": "The client's IP address as the gateway saw it, for the audit log only.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Done",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flag"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: invalid input or X-Tenant-Id, or a value of the wrong kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: not from the internal network",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: shutting down, or the audit log is down (changes are refused)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT: the key is taken in this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["key", "kind", "offValue"],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["boolean", "string"]
                  },
                  "offValue": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string",
                        "maxLength": 200
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
