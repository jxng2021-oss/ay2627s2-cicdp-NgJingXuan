            "description": "SERVICE_UNAVAILABLE: shutting down, or the audit log is down (changes are refused)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["environment", "context"],
                "additionalProperties": false,
                "properties": {
                  "environment": {
                    "type": "string",
                    "enum": ["development", "staging", "production"]
                  },
                  "context": {
                    "type": "object",
                    "required": ["key"],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "attributes": {
                        "type": "object",
                        "maxProperties": 50,
                        "additionalProperties": false,
                        "patternProperties": {
                          "^[A-Za-z][A-Za-z0-9_]{0,39}$": {
                            "oneOf": [
                              {
                                "type": "string",
                                "maxLength": 200
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        }
                      }
                    }
                  },
                  "keys": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tenant": {
      "delete": {
        "summary": "Crypto-shredding a workspace: delete all its flags (safe to repeat)",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "description": "Tenant verified by the gateway (from the API key or the dashboard membership). The only source of the tenant.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "description": "The gateway's request ID, used in this service's logs and errors",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Id",
            "in": "header",
            "required": false,
            "description": "The verified API key's or dashboard user's ID, for the audit log only. Ignored unless a UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Type",
            "in": "header",
            "required": false,
            "description": "Whose ID X-Actor-Id is: api_key (default) or user. For the audit log only.",
            "schema": {
              "type": "string",
              "enum": ["api_key", "user"]
            }
          },
          {
            "name": "X-Client-Ip",
            "in": "header",
            "required": false,
            "description": "The client's IP address as the gateway saw it, for the audit log only.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST: invalid input or X-Tenant-Id, or a value of the wrong kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: not from the internal network",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE: shutting down, or the audit log is down (changes are refused)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Flag": {
        "type": "object",
        "required": [
          "key",
          "description",
          "kind",
          "offValue",
          "environments",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["boolean", "string"]
          },
          "offValue": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 200
              }
            ]
          },
          "environments": {
            "type": "object",
            "required": ["development", "staging", "production"],
            "additionalProperties": false,
            "properties": {
              "development": {
                "$ref": "#/components/schemas/EnvironmentSettings"
              },
              "staging": {
                "$ref": "#/components/schemas/EnvironmentSettings"
              },
              "production": {
                "$ref": "#/components/schemas/EnvironmentSettings"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EnvironmentSettings": {
        "type": "object",
        "required": ["enabled", "rules", "defaultValue"],
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "rules": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["conditions", "value"],
              "additionalProperties": false,
              "properties": {
                "conditions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "required": ["attribute", "operator", "values"],
                    "additionalProperties": false,
                    "properties": {
                      "attribute": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "equals",
                          "not_equals",
                          "in",
                          "not_in",
                          "contains",
                          "starts_with",
                          "greater_than",
                          "less_than"
                        ]
                      },
                      "values": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 50,
                        "items": {
                          "type": "string",
                          "maxLength": 200
                        }
                      }
                    }
                  }
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "maxLength": 200
                    }
                  ]
                },
                "percentage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          },
          "rollout": {
            "type": "object",
            "required": ["percentage", "value"],
            "additionalProperties": false,
            "properties": {
              "percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "value": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "maxLength": 200
                  }
                ]
              }
            }
          },
          "defaultValue": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 200
              }
            ]
          }
        }
      },
      "Evaluation": {
        "type": "object",
        "required": ["environment", "flags"],
        "additionalProperties": false,
        "properties": {
          "environment": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "flags": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["value", "reason"],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "maxLength": 200
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "enum": ["off", "rule", "rollout", "default"]
                },
                "ruleIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["status", "checks"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready", "not_ready"]
          },
          "checks": {
            "type": "object",
            "properties": {
              "postgres": {
                "type": "string",
                "enum": ["up", "down"]
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
