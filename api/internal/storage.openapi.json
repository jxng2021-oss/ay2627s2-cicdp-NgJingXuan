    "/tenant": {
      "delete": {
        "summary": "Delete every file of the tenant (gateway only, when a workspace is deleted)",
        "description": "Crypto-shredding (docs/decisions/0020): marks every file of the tenant deleting and destroys its wrapped key, removes the encrypted data and the tenant's folder, then the records and usage. Called after the secrets service destroyed the tenant's key. Safe to call again. INTERNAL ONLY: no public gateway route maps to it.",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "description": "Tenant verified by the gateway from the API key",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
