  "components": {
    "schemas": {
      "FileMetadata": {
        "type": "object",
        "required": ["id", "name", "contentType", "size", "createdAt"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FileList": {
        "type": "object",
        "required": ["files", "nextCursor"],
        "additionalProperties": false,
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileMetadata"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": ["usedBytes", "reservedBytes", "limitBytes"],
        "additionalProperties": false,
        "properties": {
          "usedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "reservedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "limitBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "PAYLOAD_TOO_LARGE",
                  "STORAGE_QUOTA_EXCEEDED",
                  "SECRETS_SEALED",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
